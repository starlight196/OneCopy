<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OneCopy</AssemblyName>
    <RootNamespace>OneCopy</RootNamespace>
    <AssemblyTitle>OneCopy 重复文件清理工具</AssemblyTitle>
    <ApplicationUseVisualStyles>true</ApplicationUseVisualStyles>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 版本信息 -->
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>OneCopy 重复文件清理工具</Product>
    <Description>只留一份：基于 SHA-256 的重复文件查找与清理工具</Description>
    <Authors>starlight196</Authors>
    <Copyright>Copyright (C) 2026 starlight196</Copyright>
  </PropertyGroup>

</Project>
